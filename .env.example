# TSETMC CDN API Settings
TSETMC_BASE_URL=https://cdn.tsetmc.com/api
TSETMC_TIMEOUT_SECONDS=20
TSETMC_MAX_RPS=2.0
TSETMC_MAX_CONCURRENCY=2
TSETMC_MAX_RETRIES=3
TSETMC_START_DATE=20230321
TSETMC_RESPECT_TRADING_HOURS=true
TSETMC_USE_FIXTURES=false

# Storage & Database Paths
DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
FIXTURES_DIR=./data/fixtures
STATE_DB_PATH=./data/state.sqlite
DUCKDB_PATH=./data/market.duckdb

# Backend & Frontend Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
